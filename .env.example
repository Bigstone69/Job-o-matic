# Job-o-matic Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration
# ============================================================================
DB_PASSWORD=your_secure_password_here
DB_DATABASE_URL=postgresql+asyncpg://jobuser:your_secure_password_here@localhost:5432/jobmanager
DB_ECHO_SQL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ============================================================================
# Job Search Configuration
# ============================================================================

# JobSpy API (if using external service)
JOBSPY_API_KEY=

# OpenWeb Ninja API (alternative)
OPENWEB_NINJA_API_KEY=

# Browser Automation
ENABLE_BROWSER_AUTOMATION=false
BROWSER_AUTOMATION_DELAY=7

# ============================================================================
# Application Configuration
# ============================================================================
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ============================================================================
# API Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Redis (Optional - for caching)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ============================================================================
# MCP Server Configuration
# ============================================================================
MCP_SERVER_NAME=job-manager
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=stdio
